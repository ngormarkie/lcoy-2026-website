rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function profileExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isSuperAdmin() {
      return profileExists() && myRole() == 'superadmin';
    }
    // "Admin" is a level below super-admin with full day-to-day operational
    // access, but no destructive/irreversible powers and no reach into
    // admin/super-admin accounts — see the users rules below.
    function isAdmin() {
      return profileExists() && myRole() == 'admin';
    }
    // Broadened to admin so every "organiser-level" rule below (sessions,
    // announcements, resources, feedback, applications, mail) already
    // extends to admins with no further changes needed there.
    function isOrganiser() {
      return profileExists() && (myRole() == 'organiser' || myRole() == 'admin' || myRole() == 'superadmin');
    }
    function isCheckin() {
      return profileExists() && myRole() == 'checkin';
    }
    // Only these fields may be touched by check-in staff.
    function onlyCheckinFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['entries', 'meals', 'suppliesIssued']);
    }
    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }
    function isLowerRole(r) {
      return r == 'attendee' || r == 'checkin' || r == 'organiser';
    }
    // A delegate may set their own headshot photo exactly once (from empty).
    // Once set, changing it requires a staff member — they ask an admin.
    function photoLocked() {
      return resource.data.photoURL != null && resource.data.photoURL != '';
    }

    // ---------- USERS ----------
    match /users/{uid} {
      // Any signed-in staff member can read the directory (needed to look up
      // people by badge code at verification). Unauthenticated reads are blocked
      // (the first-run check handles the rejection gracefully).
      allow read: if isSignedIn();

      // Super-admin can create anyone. Admin can create attendees, check-in
      // staff and organisers — never another admin or super-admin. A plain
      // organiser can only create attendees.
      // First-run super-admin bootstrap must be done with rules temporarily
      // relaxed in the Firebase console (the super-admin already exists).
      allow create: if isSuperAdmin()
        || (isAdmin() && isLowerRole(request.resource.data.role))
        || (isOrganiser() && request.resource.data.role == 'attendee');

      // A person can edit their own profile but never their role / code /
      // email, and can only ever set their own photo once — once photoURL
      // is non-empty, changing it again requires a staff member.
      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'code', 'email'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoURL'])
              || !photoLocked());

      // Super-admin can edit anyone, any field. Admin and plain organisers
      // can edit non-admin/non-super-admin people's fields freely; an admin
      // may also reassign a role among the three lower tiers (never
      // touching an existing admin/super-admin, and never promoting anyone
      // to admin/super-admin). A plain organiser can never change a role.
      allow update: if isSuperAdmin()
        || (isAdmin() && isLowerRole(resource.data.role) && isLowerRole(request.resource.data.role))
        || (myRole() == 'organiser' && roleUnchanged() && isLowerRole(resource.data.role));

      // Check-in staff may only write entry / meal / supply records.
      allow update: if isCheckin() && onlyCheckinFields();

      // Super-admin can delete anyone. Admin can delete anyone except an
      // existing admin or super-admin.
      allow delete: if isSuperAdmin()
        || (isAdmin() && isLowerRole(resource.data.role));
    }

    // Broadcast content is publicly readable so the attendee Live board
    // (/live) works without anyone logging in. Writes stay organiser-only.

    // ---------- SESSIONS ----------
    function sessionOpen(id) {
      return get(/databases/$(database)/documents/sessions/$(id)).data.allowRegistration == true;
    }
    // A delegate signing themselves up moves exactly one seat, one way. Anything
    // else touching these counters is an organiser write. Reads default to 0 so
    // a session saved before these counters existed still accepts sign-ups
    // instead of failing the whole rule on a missing field.
    function countersMoveByOne() {
      let wasConfirmed = resource.data.get('regConfirmed', 0);
      let wasWaitlist = resource.data.get('regWaitlist', 0);
      let nowConfirmed = request.resource.data.get('regConfirmed', 0);
      let nowWaitlist = request.resource.data.get('regWaitlist', 0);
      return (nowConfirmed == wasConfirmed + 1 && nowWaitlist == wasWaitlist)
          || (nowWaitlist == wasWaitlist + 1 && nowConfirmed == wasConfirmed)
          || (nowConfirmed == wasConfirmed - 1 && nowWaitlist == wasWaitlist)
          || (nowWaitlist == wasWaitlist - 1 && nowConfirmed == wasConfirmed);
    }

    match /sessions/{id} {
      allow read: if true;
      allow write: if isOrganiser();

      // Delegates register themselves from their own My Sessions page (there
      // is no Cloud Function — that would need the Blaze plan), so they need
      // to nudge this session's seat counters. Restricted to the two counter
      // fields, one seat at a time, and only while sign-up is open: everything
      // else about the session stays organiser-only.
      allow update: if isSignedIn()
        && resource.data.allowRegistration == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['regConfirmed', 'regWaitlist'])
        && countersMoveByOne();

      // Registrations are keyed by the delegate's own uid, so a person can
      // only ever create or withdraw their own place. Staff read the lists and
      // mark attendance; organisers promote off the waitlist or remove someone.
      match /registrations/{regId} {
        allow read: if isSignedIn();
        allow create: if isSelf(regId) && sessionOpen(id);
        allow update: if isOrganiser() || isCheckin();
        allow delete: if isOrganiser() || isSelf(regId);
      }
    }

    // ---------- ANNOUNCEMENTS ----------
    match /announcements/{id} {
      allow read: if true;
      allow write: if isOrganiser();
    }

    // ---------- RESOURCES ----------
    match /resources/{id} {
      allow read: if true;
      allow write: if isOrganiser();
    }

    // ---------- FEEDBACK ----------
    // Anyone can submit from the public board; only organisers can read/remove.
    match /feedback/{id} {
      allow create: if true;
      allow read, delete: if isOrganiser();
    }

    // ---------- APPLICATIONS ----------
    // Anyone can submit the public application form. Only organisers can
    // read the pool, move applicants through screening, or remove one.
    // The document id is the applicant's own (lowercased) email, so a
    // second submission from the same address is a Firestore "update" of
    // an existing doc rather than a "create" of a new one — and only
    // organisers may update, so the resubmission is rejected server-side.
    match /applications/{id} {
      allow create: if true;
      allow read, update, delete: if isOrganiser();
    }

    // Lightweight public existence check ("has this email already applied?")
    // so the form can warn someone before they fill in all 24 questions,
    // without granting read access to the applications collection itself
    // (which holds essays and personal details). Holds nothing but a
    // timestamp; `list` stays denied so the set of emails can't be
    // enumerated, only checked one at a time by someone who already has
    // that exact address. Same create/update trick prevents overwrites.
    match /applicationEmails/{email} {
      allow get: if true;
      allow create: if true;
      // Deleting the application itself (e.g. a test submission) also
      // deletes this marker, so the same email can apply again.
      allow delete: if isOrganiser();
      allow list, update: if false;
    }

    // ---------- EXHIBITOR APPLICATIONS ----------
    // Anyone can submit the public /exhibit form, but only the two consent
    // declarations make a submission valid. Reads stay organiser-only: these
    // hold business contact details, and delegates are signed-in accounts on
    // this site, so "any authenticated user" would expose them to the whole
    // delegate list.
    match /exhibitorApplications/{id} {
      allow create: if request.resource.data.keys().hasAll([
                         'businessName', 'sector', 'repName', 'repEmail',
                         'repWhatsapp', 'consentMedia', 'consentTerms'
                       ])
                    && request.resource.data.consentMedia == true
                    && request.resource.data.consentTerms == true
                    && request.resource.data.status == 'new';
      allow read, update, delete: if isOrganiser();
    }

    // ---------- SETTINGS ----------
    // Small named config docs (e.g. settings/application: { open: boolean }).
    // Public single-doc read so the application form can check its own
    // open/closed state without anyone being logged in; only organisers can
    // change it, and the collection can't be listed/enumerated.
    match /settings/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if isOrganiser();
    }

    // ---------- MAIL (Firebase "Trigger Email" extension) ----------
    // Organisers queue emails; the extension reads server-side.
    match /mail/{id} {
      allow create: if isOrganiser();
      allow read, update, delete: if false;
    }

    // Everything else is denied by default.
  }
}
